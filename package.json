{
  "name": "pdf-viewer-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "vite build --config vite.web.config.ts",
    "build:extension": "vite build --config vite.extension.config.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": { "pdfjs-dist": "6.5.438" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "6.0.3", "vite": "8.3.8" }
}
