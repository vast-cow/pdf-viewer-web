{
  "manifest_version": 3,
  "name": "PDF Reader",
  "version": "1.0.0",
  "description": "Read and search PDFs with an optional hue-preserving lightness inversion.",
  "minimum_chrome_version": "134",
  "permissions": ["storage"],
  "host_permissions": ["file:///*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open PDF Reader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
